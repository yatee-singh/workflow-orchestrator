# App
APP_NAME=orderflow
LOG_LEVEL=INFO

# Postgres
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@postgres:5432/orderflow

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://guest:guest@rabbitmq:15672/api

# Payment simulation (Phase 3) — raise toward 1.0 to force DLQ demos
PAYMENT_FAIL_RATE=0.35
MAX_RETRIES=3
